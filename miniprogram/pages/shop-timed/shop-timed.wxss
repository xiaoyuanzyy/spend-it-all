/* pages/shop-timed/shop-timed.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-deep);
  padding-bottom: 200rpx;
}

.status-bar {
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f5f1e6;
  font-size: 30rpx;
  font-weight: 600;
}

.budget {
  text-align: center;
  padding: 30rpx 0 20rpx;
}

.budget-label { font-size: 24rpx; color: #d4af37; letter-spacing: 4rpx; }
.budget-amount { font-size: 64rpx; color: #d4af37; font-weight: 700; margin-top: 10rpx; }

.timer {
  padding: 0 32rpx 24rpx;
}

.timer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.timer-row .left { color: #ff5a4d; font-weight: 600; display: flex; align-items: center; gap: 6rpx; }
.timer-row .right { color: #d4af37; font-weight: 600; }

.timer-track {
  height: 12rpx;
  background: rgba(255, 90, 77, 0.15);
  border-radius: 6rpx;
  overflow: hidden;
}

.timer-fill {
  height: 100%;
  background: linear-gradient(to right, #ff5a4d, #ff8a4d, #ffc04d);
  border-radius: 6rpx;
  transition: width 1s linear;
}

.products {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 24rpx;
}

.product-card {
  background: #11183a;
  border-radius: 24rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  overflow: hidden;
  position: relative;
}

.bought-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #2ecc71;
  color: #fff;
  font-size: 20rpx;
  z-index: 2;
}

.product-image {
  width: 100%;
  height: 220rpx;
  background: #0a1129;
  background-size: cover;
  background-position: center;
}

.product-info { padding: 16rpx 20rpx 20rpx; }
.product-name { color: #f5f1e6; font-size: 26rpx; font-weight: 600; margin-bottom: 8rpx; }
.product-price { color: #d4af37; font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }

.product-actions { display: flex; gap: 12rpx; align-items: center; }

.qty-input {
  flex: 0 0 90rpx;
  height: 50rpx;
  background: #0a1129;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  border-radius: 12rpx;
  text-align: center;
  color: #f5f1e6;
  font-size: 26rpx;
}

.buy-btn {
  flex: 1;
  height: 50rpx;
  line-height: 50rpx;
  border-radius: 12rpx;
  background: #0a1129;
  border: 1rpx solid #d4af37;
  color: #d4af37;
  font-size: 24rpx;
  text-align: center;
}

.scroll-hint { text-align: center; color: #a0a0a0; font-size: 22rpx; margin: 30rpx 0 20rpx; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #0a1129;
  border-top: 2rpx solid rgba(212, 175, 55, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}

.total {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  color: #d4af37;
  font-size: 32rpx;
  font-weight: 700;
}

.total-label { font-size: 24rpx; }
.total-amount { font-size: 36rpx; font-weight: 700; }

.reaction-bubble {
  position: fixed;
  top: 30%;
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  z-index: 200;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
}

.reaction-bubble.positive { border: 2rpx solid #2ecc71; }
.reaction-bubble.negative { border: 2rpx solid #e74c3c; }
