/* pages/room-ready/room-ready.wxss */
.page { min-height: 100vh; background: #f6efde; padding: 0 32rpx 60rpx; }
.status-bar { height: 62rpx; display: flex; align-items: center; justify-content: center; color: #1a1a2e; font-size: 30rpx; font-weight: 600; }
.header-row { display: flex; align-items: center; padding: 16rpx 0; }
.back-btn { display: flex; align-items: center; gap: 4rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: #f6efde; color: #1a1a2e; font-size: 24rpx; border: 1rpx solid #d4af37; }
.title { flex: 1; text-align: center; display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 32rpx; font-weight: 700; color: #1a1a2e; }
.title-icon { color: #d4af37; }
.divider { height: 1rpx; background: rgba(212, 175, 55, 0.3); margin-bottom: 40rpx; }
.room-card { background: #ffffff; border: 2rpx solid #d4af37; border-radius: 16rpx; padding: 40rpx 32rpx 30rpx; text-align: center; margin-bottom: 30rpx; }
.room-label { font-size: 24rpx; color: #d4af37; }
.room-code { font-size: 72rpx; font-weight: 700; color: #1a1a2e; letter-spacing: 4rpx; margin: 16rpx 0 20rpx; }
.copy-btn { display: inline-flex; align-items: center; gap: 6rpx; padding: 10rpx 32rpx; border-radius: 999rpx; background: #f6efde; color: #d4af37; border: 1rpx solid #d4af37; font-size: 24rpx; }
.player-card { background: #ffffff; border: 2rpx solid #d4af37; border-radius: 16rpx; padding: 30rpx 32rpx; margin-bottom: 30rpx; }
.player-card-title { color: #d4af37; font-size: 24rpx; margin-bottom: 24rpx; }
.player-row { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f0e6c5; }
.player-row:last-child { border-bottom: none; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #f6efde; display: flex; align-items: center; justify-content: center; color: #d4af37; font-weight: 700; font-size: 32rpx; border: 2rpx solid #d4af37; }
.avatar.empty { color: #a0a0a0; border-color: #d0c8b0; }
.player-info { flex: 1; }
.player-name { font-size: 28rpx; color: #1a1a2e; font-weight: 600; }
.player-tag { display: inline-block; margin-top: 6rpx; padding: 2rpx 12rpx; border-radius: 999rpx; background: #d4af37; color: #fff; font-size: 20rpx; }
.player-slot { color: #a0a0a0; font-size: 22rpx; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #f6efde; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 16rpx; }
.btn-gold { width: 100%; height: 96rpx; border-radius: 999rpx; background: #d4af37; color: #1a1a2e; font-size: 30rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.btn-gold-gradient { width: 100%; height: 96rpx; border-radius: 999rpx; background: linear-gradient(to right, #d4af37 0%, #ff8c42 50%, #ff5a4d 100%); color: #ffffff; font-size: 30rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.btn-red-outline { width: 100%; height: 96rpx; border-radius: 999rpx; background: transparent; border: 2rpx solid #e74c3c; color: #e74c3c; font-size: 30rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.wave { width: 200rpx; height: 16rpx; margin: 30rpx auto 0; background: linear-gradient(90deg, transparent, #d4af37, transparent); border-radius: 50%; opacity: 0.3; }
