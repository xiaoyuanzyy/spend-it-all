/* pages/room-ready/room-ready.wxss */

.page {
  min-height: 100vh;
  background: #f6efde;
  padding: 0 32rpx 60rpx;
  position: relative;
}

/* ---- 头部：对齐 profile ---- */
.header-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
  background: #f6efde;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #d4af37;
  font-weight: 300;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  letter-spacing: 4rpx;
}

.title-icon { color: #d4af37; }

/* ---- 房间卡片 ---- */
.room-card {
  background: #ffffff;
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 40rpx 32rpx 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
  margin-top: 20rpx;
}

.room-label { font-size: 24rpx; color: #d4af37; }
.room-code { font-size: 72rpx; font-weight: 700; color: #1a1a2e; letter-spacing: 4rpx; margin: 16rpx 0 20rpx; }

.copy-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: #f6efde;
  color: #d4af37;
  border: 1rpx solid #d4af37;
  font-size: 24rpx;
}

/* ---- 玩家卡片 ---- */
.player-card {
  background: #ffffff;
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 30rpx;
}

.player-card-title { color: #d4af37; font-size: 24rpx; margin-bottom: 24rpx; }

.player-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0e6c5;
}
.player-row:last-child { border-bottom: none; }

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f6efde;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d4af37;
  font-weight: 700;
  font-size: 32rpx;
  border: 2rpx solid #d4af37;
}
.avatar.empty { color: #a0a0a0; border-color: #d0c8b0; }

.player-info { flex: 1; }
.player-name { font-size: 28rpx; color: #1a1a2e; font-weight: 600; }

.player-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.player-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #d4af37;
  color: #fff;
  font-size: 20rpx;
}
.player-tag.me {
  background: rgba(46, 204, 113, 0.15);
  border: 1rpx solid #2ecc71;
  color: #2ecc71;
}

.player-slot { color: #a0a0a0; font-size: 22rpx; }

/* ---- 底部栏 ---- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f6efde;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-gold {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #d4af37;
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-share {
  padding: 0;
  margin: 0;
  border: none;
  line-height: 96rpx;
  text-align: center;
}
.btn-share::after {
  border: none;
}

.btn-gold-gradient {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #d4af37 0%, #ff8c42 50%, #ff5a4d 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-red-outline {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 2rpx solid #e74c3c;
  color: #e74c3c;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.wave {
  width: 200rpx;
  height: 16rpx;
  margin: 30rpx auto 0;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
  border-radius: 50%;
  opacity: 0.3;
}
