<view class="page">
  <!-- 顶部固定区域：导航 + 用户信息 + 统计数据 -->
  <view class="top-fixed" id="profile-top">
    <view class="header-row" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-back" bindtap="onBack">←</view>
      <view class="title">
        <text>我的档案</text>
        <text class="title-icon">👑</text>
      </view>
    </view>

    <view class="user-card">
      <view class="avatar-wrap" bindtap="onAvatarTap">
        <image class="avatar-img" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view class="avatar avatar-text" wx:else>{{user.avatar}}</view>
        <view class="avatar-overlay">📷</view>
      </view>
      <view class="user-info">
        <view class="name-row" wx:if="{{!editing}}">
          <text class="nickname">{{user.nickname}}</text>
          <text class="edit-icon" bindtap="onEdit">✎</text>
        </view>
        <view class="name-row edit-row" wx:else>
          <input class="nickname-input" value="{{editNickname}}" placeholder="输入昵称" maxlength="20" bindinput="onNicknameInput" focus="{{true}}" />
          <text class="save-btn" bindtap="onSaveNickname">{{saving ? '...' : '✓'}}</text>
          <text class="cancel-btn" bindtap="onCancelEdit">✕</text>
        </view>
        <view class="vip">VIP No. {{user.vip}}</view>
      </view>
      <view class="role-badge">{{user.role}}</view>
    </view>

    <view class="stats-card">
      <view class="stat">
        <text class="stat-icon">⭐</text>
        <text class="stat-value">{{stats.conquered}}</text>
        <text class="stat-label">征服富豪</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat">
        <text class="stat-icon">$</text>
        <text class="stat-value">{{stats.spentDisplay}}</text>
        <text class="stat-label">挥霍金额</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat">
        <text class="stat-icon badge-icon">♦</text>
        <text class="stat-value">{{stats.badges}}</text>
        <text class="stat-label">成就徽章</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat stat-rank" bindtap="onGoLeaderboard">
        <text class="stat-icon rank-icon">🏆</text>
        <text class="stat-value">{{rank !== null ? rank : '—'}}</text>
        <text class="stat-label">排名<text class="rank-arrow"> ›</text></text>
      </view>
    </view>

    <view class="history-row">
      <view class="history-title">历史账单</view>
      <view class="clear-btn" bindtap="onClear">🗑 清空记录</view>
    </view>
  </view>

  <!-- 可滚动账单区域 -->
  <scroll-view scroll-y class="bill-scroll" enhanced show-scrollbar="{{false}}" style="top: {{scrollTop}}px; height: {{scrollHeight}}px;">
    <view class="bill-inner">
      <block wx:if="{{bills.length > 0}}">
        <block wx:for="{{bills}}" wx:key="_id">
          <view class="bill-card">
            <view class="bill-head">
              <text class="bill-name">{{item.billionaireName || '富豪'}}</text>
              <view class="bill-head-right">
                <text class="conquer-flag" wx:if="{{item.conquered}}">🏆 已征服</text>
                <text class="bill-amount">{{item.amountDisplay}}</text>
              </view>
            </view>
            <view class="bill-meta">
              <text>第{{item.period}}期 · {{item.timeDisplay}}</text>
              <view class="bill-meta-right">
                <text class="mode-badge mode-{{item.modeKey}}">{{item.modeLabel}}</text>
                <text class="progress-tag {{item.isOver ? 'over' : ''}}">{{item.isOver ? '已超预算' : item.progress + '%'}}</text>
              </view>
            </view>
            <view class="bill-medals" wx:if="{{item.medals.length > 0}}">
              <text class="bm-item" wx:for="{{item.medals}}" wx:key="*this" wx:for-item="medal">{{medal}}</text>
            </view>
            <view class="bill-actions">
              <view class="bill-items">
                <block wx:for="{{item.topProducts}}" wx:for-item="p" wx:key="id">
                  {{p.name}}×{{p.qty}}<block wx:if="{{!last}}"> </block>
                </block>
                <text wx:if="{{item.productCount > 3}}" class="bill-more"> 等{{item.productCount}}种</text>
              </view>
              <view class="bill-actions-right">
                <view class="view-btn" bindtap="onViewBill" data-idx="{{index}}">查看</view>
                <view class="delete-btn" bindtap="onDelete" data-id="{{item._id}}">🗑 删除</view>
              </view>
            </view>
          </view>
        </block>
      </block>

      <view class="empty" wx:else>
        <view class="empty-illust">😶</view>
        <view class="empty-text">暂无消费记录</view>
        <view class="empty-sub">快去拯救富豪吧！</view>
      </view>

      <view style="height: 160rpx;"></view>
    </view>
  </scroll-view>

  <view class="retire-fixed">
    <view class="feedback-link" bindtap="onFeedback">我要留言</view>
  </view>
</view>
