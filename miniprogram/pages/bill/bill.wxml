<view class="page">
  <view class="header" id="bill-header">
    <view class="nav-wrap" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-bar">
        <view class="nav-back" bindtap="onBack">←</view>
        <text class="nav-title">支出账单</text>
      </view>
    </view>
    <view class="title">
      <view class="title-period">{{period}}</view>
      <view class="mode-tag mode-{{mode}}">{{modeLabel}}</view>
    </view>
  </view>

  <!-- 富豪信息卡片 -->
  <view class="billion-card">
    <view class="billion-avatar">{{billionAvatar || '👑'}}</view>
    <view class="billion-body">
      <view class="billion-name">{{billionName}}</view>
      <view class="billion-assets">资产 {{billionAssets}}</view>
      <view class="billion-tags" wx:if="{{billionTags.length > 0}}">
        <text class="b-tag" wx:for="{{billionTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="billion-quote" wx:if="{{billionCatchphrase}}">"{{billionCatchphrase}}"</view>
    </view>
  </view>

  <scroll-view scroll-y class="scroll-area" enhanced show-scrollbar="{{false}}" style="height: {{scrollHeight}}px;">
    <view class="table">
      <view class="table-header">
        <view class="col-name">商品</view>
        <view class="col-qty">数量</view>
        <view class="col-price">单价</view>
      </view>
      <block wx:for="{{items}}" wx:key="id">
        <view class="table-row">
          <view class="col-name">{{item.name}}</view>
          <view class="col-qty">{{item.qty}}</view>
          <view class="col-price">{{item.unitPriceDisplay}}</view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="summary" id="bill-summary">
    <view class="summary-label">总花费</view>
    <view class="summary-amount">{{totalDisplay}}</view>
    <view class="summary-stats">
      <text>商品 {{itemTypes}} 种</text>
      <text class="stats-sep">|</text>
      <text>共 {{totalQty}} 件</text>
    </view>
    <view class="summary-over {{isOver ? '' : 'normal'}}">
      <block wx:if="{{isOver}}">超出预算 超额 {{overDisplay}}</block>
      <block wx:else>没有超出预算 还差 {{remainingDisplay}}</block>
    </view>
  </view>

  <view class="status-box" id="bill-status">
    <view class="satisfy-meta">亿万富豪满意度</view>
    <view class="satisfy-row">
      <view class="satisfy-stars">{{starsText}}</view>
      <view class="satisfy-emoji">{{moodEmoji}}</view>
      <view class="satisfy-progress {{isOver ? 'over' : ''}}">{{progress}}%</view>
    </view>
  </view>

  <view class="bottom-fixed" id="bill-bottom">
    <view class="bottom-bar">
      <view class="btn-replay" bindtap="onReplay">
        <text>↻</text>
        <text>再来一局</text>
      </view>
      <view class="btn-share" bindtap="onShare">
        <text>↑</text>
        <text>分享报告</text>
      </view>
    </view>
    <view class="history-bar">
      <view class="btn-history" bindtap="onHistory">查看历史账单</view>
    </view>
  </view>
</view>
