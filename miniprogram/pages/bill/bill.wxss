/* pages/bill/bill.wxss */
.page {
  height: 100vh;
  background: #f6efde;
  color: #1a1a2e;
  position: relative;
  overflow: hidden;
}

/* 滚动区域 - 仅包裹商品表格 */
.scroll-area {
  padding: 0 32rpx;
  box-sizing: border-box;
}

.page::before {
  content: '$';
  position: absolute;
  top: 240rpx;
  left: 40rpx;
  font-size: 480rpx;
  color: rgba(212, 175, 55, 0.08);
  font-weight: 900;
  pointer-events: none;
}

.title {
  text-align: center;
  padding: 16rpx 0 24rpx;
}

.nav-wrap {
  background: #f6efde;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #d4af37;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #d4af37;
  letter-spacing: 6rpx;
}

.title-period { font-size: 40rpx; font-weight: 700; }

/* 模式标签 */
.mode-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.mode-normal {
  background: rgba(212, 175, 55, 0.15);
  border: 1rpx solid #d4af37;
  color: #d4af37;
}
.mode-timed {
  background: rgba(255, 90, 77, 0.12);
  border: 1rpx solid #ff5a4d;
  color: #ff5a4d;
}
.mode-challenge {
  background: rgba(46, 204, 113, 0.12);
  border: 1rpx solid #2ecc71;
  color: #2ecc71;
}

/* 富豪信息卡片 */
.billion-card {
  display: flex;
  align-items: center;
  margin: 4rpx 32rpx 20rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
  gap: 20rpx;
}

.billion-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f6efde;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.billion-body {
  flex: 1;
  min-width: 0;
}

.billion-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.billion-assets {
  font-size: 22rpx;
  color: #d4af37;
  font-weight: 600;
  margin-top: 4rpx;
}

.billion-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.b-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: rgba(212, 175, 55, 0.12);
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #d4af37;
}

.billion-quote {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #999;
  font-style: italic;
}

.table {
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #d4af37;
  overflow: hidden;
}

.table-header {
  display: flex;
  padding: 20rpx 24rpx;
  background: #f6efde;
  border-bottom: 1rpx solid #d4af37;
  font-size: 24rpx;
  color: #1a1a2e;
  font-weight: 600;
}

.table-row {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0e6c5;
  font-size: 24rpx;
}

.table-row:last-child { border-bottom: none; }
.col-name { flex: 1; }
.col-qty { width: 100rpx; text-align: center; }
.col-price { width: 180rpx; text-align: right; color: #1a1a2e; }

/* 底部固定区域 - 包含总花费/满意度/按钮 */
.bottom-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #f6efde;
  border-top: 1rpx solid rgba(212, 175, 55, 0.3);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.bottom-fixed .summary {
  margin: 0 0 12rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border: 2rpx solid #d4af37;
  border-radius: 12rpx;
  text-align: center;
}

.bottom-fixed .summary-label { font-size: 22rpx; color: #d4af37; font-weight: 600; }
.bottom-fixed .summary-amount { font-size: 44rpx; font-weight: 700; color: #1a1a2e; margin: 4rpx 0 2rpx; }
.bottom-fixed .summary-stats { font-size: 20rpx; color: #666; margin-bottom: 2rpx; }
.bottom-fixed .stats-sep { margin: 0 8rpx; color: #ccc; }
.bottom-fixed .summary-over { font-size: 20rpx; color: #e74c3c; }
.bottom-fixed .summary-over.normal { color: #2ecc71; }

.bottom-fixed .status-box {
  margin: 0 0 12rpx;
  padding: 16rpx 24rpx;
  background: #1a1a2e;
  border-radius: 12rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.5);
  text-align: center;
}

.bottom-fixed .satisfy-meta {
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.bottom-fixed .satisfy-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.bottom-fixed .satisfy-stars {
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: #d4af37;
}

.bottom-fixed .satisfy-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.bottom-fixed .satisfy-progress {
  font-size: 24rpx;
  font-weight: 700;
  color: #d4af37;
  min-width: 60rpx;
}

.bottom-fixed .satisfy-progress.over {
  color: #f08080;
}

.bottom-fixed .bottom-bar {
  display: flex;
  gap: 16rpx;
  padding: 0;
}

.bottom-fixed .btn-replay {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  background: #1a1a2e;
  color: #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.bottom-fixed .btn-share {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  background: #d4af37;
  color: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.bottom-fixed .history-bar {
  padding: 12rpx 0 0;
}

.bottom-fixed .btn-history {
  height: 64rpx;
  border-radius: 12rpx;
  background: rgba(212, 175, 55, 0.12);
  border: 2rpx solid rgba(212, 175, 55, 0.35);
  color: #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.bottom-fixed .btn-history:active {
  background: rgba(212, 175, 55, 0.25);
}
