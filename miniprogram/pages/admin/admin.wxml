<!-- pages/admin/admin.wxml -->
<view class="page">
  <!-- 头部统计 -->
  <view class="header">
    <view class="title">AI 商品图片批量生成</view>
    <view class="subtitle">调用 Pollinations.ai 生图 → 上传云存储 → 更新数据库</view>
  </view>

  <!-- 进度卡片 -->
  <view class="progress-card">
    <view class="progress-row">
      <view class="stat">
        <text class="stat-num">{{completed}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{remaining}}</text>
        <text class="stat-label">待处理</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{total}}</text>
        <text class="stat-label">总数</text>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{completed / total * 100}}%"></view>
    </view>

    <!-- 运行时间 -->
    <view wx:if="{{running}}" class="runtime">
      ⏱ 已运行 {{runtime}} 秒
    </view>
  </view>

  <!-- 按钮区 -->
  <view class="actions">
    <button wx:if="{{!running}}" class="btn btn-start" bindtap="onStartAll">
      🚀 开始批量生成
    </button>
    <button wx:if="{{running}}" class="btn btn-stop" bindtap="onStop">
      ⏹ 停止
    </button>
    <button class="btn btn-refresh" bindtap="checkProgress" disabled="{{running}}">
      🔄 刷新进度
    </button>
  </view>

  <!-- 当前批次状态 -->
  <view wx:if="{{currentBatch.length > 0}}" class="batch-status">
    <view class="section-title">当前批次</view>
    <view wx:for="{{currentBatch}}" wx:key="productId" class="batch-item {{item.success ? 'success' : 'fail'}}">
      <text class="batch-icon">{{item.success ? '✅' : '❌'}}</text>
      <text class="batch-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 完成提示 -->
  <view wx:if="{{!running && completed >= total && total > 0}}" class="done-banner">
    🎉 全部 {{total}} 件商品图片生成完成！
  </view>

  <!-- 运行日志 -->
  <view class="logs-section">
    <view class="section-title">运行日志（最新 200 条）</view>
    <scroll-view scroll-y class="logs-scroll" scroll-into-view="log-bottom">
      <view wx:for="{{logs}}" wx:key="index" class="log-line">{{item}}</view>
      <view id="log-bottom"></view>
    </scroll-view>
  </view>
</view>
