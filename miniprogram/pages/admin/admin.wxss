/* pages/admin/admin.wxss */

.page {
  min-height: 100vh;
  background: #0a1129;
  padding: 24rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.header {
  text-align: center;
  padding: 32rpx 0 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #d4af37;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 22rpx;
  color: #8892b0;
}

/* ===== 进度卡片 ===== */
.progress-card {
  background: linear-gradient(135deg, #11183a, #1a1f4e);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.progress-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.stat {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #d4af37;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #8892b0;
  margin-top: 4rpx;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d4af37, #f0d060);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.runtime {
  text-align: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8892b0;
}

/* ===== 按钮 ===== */
.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}

.btn-start {
  background: linear-gradient(135deg, #d4af37, #b8941f);
  color: #0a1129;
}

.btn-stop {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  color: #fff;
}

.btn-refresh {
  background: rgba(255, 255, 255, 0.08);
  color: #d4af37;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}

/* ===== 批次状态 ===== */
.batch-status {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: #8892b0;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.batch-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  background: rgba(255, 255, 255, 0.04);
}

.batch-item.success {
  border-left: 4rpx solid #27ae60;
}

.batch-item.fail {
  border-left: 4rpx solid #e74c3c;
}

.batch-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.batch-name {
  font-size: 24rpx;
  color: #ccd6f6;
}

/* ===== 完成横幅 ===== */
.done-banner {
  text-align: center;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(39, 174, 96, 0.15), rgba(212, 175, 55, 0.1));
  border-radius: 12rpx;
  border: 1rpx solid rgba(39, 174, 96, 0.3);
  color: #27ae60;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* ===== 日志区域 ===== */
.logs-section {
  flex: 1;
}

.logs-scroll {
  height: 500rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.log-line {
  font-size: 20rpx;
  color: #8892b0;
  line-height: 1.8;
  font-family: 'Courier New', monospace;
  white-space: nowrap;
}
