/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  background: #f6efde;
  padding: 0 32rpx 200rpx;
}

.status-bar {
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1a2e;
  font-size: 30rpx;
  font-weight: 600;
}

.header-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f6efde;
  color: #1a1a2e;
  font-size: 24rpx;
  border: 1rpx solid #d4af37;
}

.title {
  flex: 1;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.title-icon { color: #d4af37; }

.divider {
  height: 1rpx;
  background: rgba(212, 175, 55, 0.3);
  margin-bottom: 30rpx;
}

.winner-card {
  background: #ffffff;
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 30rpx 32rpx;
  text-align: center;
  position: relative;
  margin-bottom: 40rpx;
}

.crown {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 60rpx;
}

.winner-label { color: #d4af37; font-size: 24rpx; font-weight: 600; }
.winner-name { font-size: 56rpx; font-weight: 700; color: #1a1a2e; margin: 16rpx 0; }
.winner-amount { color: #d4af37; font-size: 32rpx; font-weight: 600; }

.rank-section { margin-bottom: 30rpx; }
.rank-title { color: #d4af37; font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }

.rank-card {
  background: #ffffff;
  border: 1rpx solid #d0c8b0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.rank-no {
  font-size: 36rpx;
  color: #d4af37;
  font-weight: 700;
  width: 50rpx;
  text-align: center;
}

.rank-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #f6efde;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d4af37;
  font-weight: 700;
  font-size: 28rpx;
  border: 2rpx solid #d4af37;
}

.rank-name { flex: 1; color: #1a1a2e; font-size: 28rpx; font-weight: 600; }
.rank-amount { color: #d4af37; font-size: 26rpx; font-weight: 600; }

.btn-replay {
  position: fixed;
  bottom: 60rpx;
  left: 32rpx;
  right: 32rpx;
  height: 100rpx;
  border-radius: 999rpx;
  background: #d4af37;
  color: #1a1a2e;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 175, 55, 0.4);
}

.btn-bill {
  position: fixed;
  bottom: 180rpx;
  left: 32rpx;
  right: 32rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx solid #d4af37;
  box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.2);
}
