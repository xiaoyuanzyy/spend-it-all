/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #faf7f0 0%, #f6efde 100%);
  display: flex;
  flex-direction: column;
}

/* ===== 导航栏 ===== */
.header-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  flex-shrink: 0;
  background: rgba(250, 247, 240, 0.95);
  backdrop-filter: blur(10rpx);
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #1a1a2e;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #d4af37;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.title {
  flex: 1;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.title-icon { font-size: 36rpx; }

.header-spacer { width: 120rpx; flex-shrink: 0; }

/* ===== 可滚动内容区 ===== */
.content-scroll {
  flex: 1;
  padding: 0 32rpx;
  min-height: 0;
}

/* ===== 通用区块头部 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.section-icon { font-size: 28rpx; }

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: 2rpx;
}

/* ===== 领奖台 ===== */
.podium-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 20rpx 24rpx;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}

/* --- 冠军（居中放大） --- */
.podium-champion {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
  position: relative;
}

.champion-crown {
  font-size: 56rpx;
  animation: crownBounce 2s ease-in-out infinite;
  margin-bottom: 4rpx;
}

@keyframes crownBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.champion-tag {
  font-size: 24rpx;
  font-weight: 800;
  color: #1a1a2e;
  background: linear-gradient(135deg, #d4af37, #f1c40f);
  padding: 4rpx 24rpx;
  border-radius: 999rpx;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(212, 175, 55, 0.3);
}

.champion-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a1a2e, #2d2d44);
  color: #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  border: 4rpx solid #d4af37;
  box-shadow: 0 0 24rpx rgba(212, 175, 55, 0.35);
  margin-bottom: 12rpx;
}

.champion-avatar.self-glow {
  box-shadow: 0 0 32rpx rgba(212, 175, 55, 0.55), 0 0 60rpx rgba(212, 175, 55, 0.2);
}

.champion-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 6rpx;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.champion-amount {
  font-size: 30rpx;
  font-weight: 800;
  color: #d4af37;
  margin-bottom: 8rpx;
}

.champion-self-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #1a1a2e;
  background: #d4af37;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

/* 冠军领奖台底座 */
.champion-stand {
  width: 240rpx;
  height: 44rpx;
  background: linear-gradient(180deg, #d4af37 0%, #b8942e 60%, #9a7b20 100%);
  border-radius: 8rpx 8rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(212, 175, 55, 0.35);
}

.stand-num {
  font-size: 26rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.3);
}

/* --- 亚军/季军/第四名 横排 --- */
.podium-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 不同人数适配宽度 */
.podium-row.podium-count-1 { gap: 0; }
.podium-row.podium-count-2 { gap: 20rpx; }
.podium-row.podium-count-3 { gap: 12rpx; }

.podium-player {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 200rpx;
}

/* 自己是玩家时高亮卡片 */
.podium-player.is-self {
  background: linear-gradient(180deg, #fffdf5 0%, #fff9e0 100%);
  border-radius: 16rpx;
  padding: 12rpx 0 0;
}

.podium-avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

/* 排名对应的头像框颜色 */
.podium-avatar-wrap.rank-2 {
  border: 3rpx solid #c0c0c0;
  box-shadow: 0 0 16rpx rgba(192, 192, 192, 0.3);
}

.podium-avatar-wrap.rank-3 {
  border: 3rpx solid #cd8532;
  box-shadow: 0 0 16rpx rgba(205, 133, 50, 0.25);
}

.podium-avatar-wrap.rank-4 {
  border: 3rpx solid #b0b0b0;
  box-shadow: 0 0 12rpx rgba(0,0,0,0.08);
}

.podium-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a1a2e, #2d2d44);
  color: #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.podium-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 4rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-amount {
  font-size: 22rpx;
  font-weight: 700;
  color: #888;
  margin-bottom: 4rpx;
}

.podium-rank-tag {
  font-size: 18rpx;
  color: #aaa;
  margin-bottom: 4rpx;
}

.podium-self-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #1a1a2e;
  background: #d4af37;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
}

/* 领奖台底座 - 不同高度和颜色 */
.podium-stand {
  width: 100%;
  border-radius: 6rpx 6rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.podium-stand-2 {
  height: 52rpx;
  background: linear-gradient(180deg, #e8e8e8 0%, #c0c0c0 60%, #a0a0a0 100%);
  box-shadow: 0 3rpx 12rpx rgba(0,0,0,0.08);
}

.podium-stand-3 {
  height: 36rpx;
  background: linear-gradient(180deg, #e8c88a 0%, #cd8532 60%, #a0692b 100%);
  box-shadow: 0 3rpx 12rpx rgba(205, 133, 50, 0.2);
}

.podium-stand-4 {
  height: 28rpx;
  background: linear-gradient(180deg, #e0e0e0 0%, #b0b0b0 60%, #909090 100%);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* 银色底座内数字 */
.podium-stand-2 .stand-num {
  color: #555;
  text-shadow: none;
}

/* ===== 单人冠军卡片（兜底） ===== */
.winner-card {
  background: linear-gradient(180deg, #fffdf5 0%, #ffffff 100%);
  border: 2rpx solid #d4af37;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
  position: relative;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(212, 175, 55, 0.1);
}

.crown {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 60rpx;
}

.winner-label {
  color: #d4af37;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.winner-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin: 16rpx 0;
}

.winner-amount {
  color: #d4af37;
  font-size: 32rpx;
  font-weight: 600;
}

/* ===== 挥霍战报卡片 ===== */
.conquest-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.conquest-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1a2e;
}

.stat-value.budget {
  font-size: 24rpx;
  font-weight: 600;
  color: #d4af37;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #e8e0cc;
}

.conquest-progress-bar {
  height: 14rpx;
  background: #f0ebe0;
  border-radius: 7rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.conquest-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d4af37, #f1c40f);
  border-radius: 7rpx;
  transition: width 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.conquest-progress-fill.over {
  background: linear-gradient(90deg, #e74c3c, #f39c12);
}

.conquest-pct-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.conquest-pct {
  font-size: 40rpx;
  font-weight: 900;
  color: #d4af37;
}

.conquest-pct.over { color: #e74c3c; }

.conquest-status {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.conquest-status.over { color: #d4af37; }

.conquest-sub {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 6rpx;
}

/* ===== 获得勋章展示区 ===== */
.medals-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 32rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.medals-list {
  display: flex;
  justify-content: center;
  gap: 56rpx;
}

.earned-medal {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.earned-medal-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f9d423 0%, #d4af37 40%, #c9a84c 60%, #d4af37 80%, #f9d423 100%);
  border: 4rpx solid #b8942e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 4rpx 24rpx rgba(212, 175, 55, 0.3);
}

.earned-medal.challenge .earned-medal-icon {
  background: linear-gradient(135deg, #f1c40f 0%, #e67e22 40%, #d35400 60%, #e67e22 80%, #f1c40f 100%);
  border-color: #c0392b;
  box-shadow: 0 4rpx 24rpx rgba(241, 196, 15, 0.3);
}

.earned-medal-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #d4af37;
  letter-spacing: 1rpx;
}

.earned-medal.challenge .earned-medal-label {
  color: #f1c40f;
}

/* ===== 底部操作栏（固定吸底） ===== */
.action-bar {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom, 20rpx));
  background: linear-gradient(180deg, rgba(250, 247, 240, 0) 0%, rgba(250, 247, 240, 0.95) 12rpx, #faf7f0 100%);
  backdrop-filter: blur(10rpx);
}

.btn-replay {
  flex: 1;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #d4af37, #c9a030);
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-shadow: 0 6rpx 20rpx rgba(212, 175, 55, 0.3);
  transition: transform 0.15s;
}

.btn-replay:active {
  transform: scale(0.97);
}

.btn-bill {
  flex: 1.5;
  height: 80rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #1a1a2e;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx solid #d4af37;
  box-shadow: 0 2rpx 12rpx rgba(212, 175, 55, 0.1);
  transition: transform 0.15s;
}

.btn-bill:active {
  transform: scale(0.97);
}

.btn-icon {
  font-size: 28rpx;
}

.bottom-safe { height: 32rpx; flex-shrink: 0; }

/* ===== 礼花动画层 ===== */
.fireworks-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.82);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: overlayFadeIn 0.4s ease;
}

@keyframes overlayFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.confetti-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

.confetti {
  position: absolute;
  top: -40rpx;
  animation: confettiFall linear forwards;
}

.confetti.circle { border-radius: 50%; }
.confetti.rect { border-radius: 2rpx; }

@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  80% { opacity: 1; }
  100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
}

.hero-text {
  color: #d4af37;
  font-size: 44rpx;
  font-weight: 900;
  text-align: center;
  text-shadow: 0 0 30rpx rgba(212, 175, 55, 0.6), 0 4rpx 12rpx rgba(0,0,0,0.5);
  letter-spacing: 4rpx;
  padding: 0 40rpx;
  z-index: 1;
  animation: conqueredBounce 0.6s ease 0.2s both;
}

@keyframes conqueredBounce {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

.hero-sub {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  z-index: 1;
  text-align: center;
  padding: 0 40rpx;
  animation: conqueredBounce 0.6s ease 0.4s both;
}

.badge-notice {
  margin-top: 36rpx;
  z-index: 1;
  animation: conqueredBounce 0.5s ease 0.6s both;
}

.badge-notice-text {
  color: #f1c40f;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  text-shadow: 0 0 20rpx rgba(241, 196, 15, 0.5);
}

.medals-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 60rpx;
  margin-top: 30rpx;
  z-index: 1;
  width: 100%;
}

/* 单勋章：强制居中 */
.medals-row.medals-count-1 {
  gap: 0;
}

.medals-row.medals-count-1 .medal-wrap {
  margin: 0 auto;
}

.medal-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: scale(0) rotateY(180deg);
}

.medal-wrap.show {
  animation: medalEntry 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
}

@keyframes medalEntry {
  0% { transform: scale(0) rotateY(180deg); opacity: 0; }
  100% { transform: scale(1) rotateY(0deg); opacity: 1; }
}

.medal-glow {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  left: 50%;
  margin-left: -90rpx;
  top: -10rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.5) 0%, transparent 70%);
  animation: medalPulse 2s ease-in-out 1s infinite;
}

@keyframes medalPulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.4); opacity: 0.15; }
}

.medal-body {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.medal-inner {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f9d423 0%, #d4af37 30%, #c9a84c 50%, #d4af37 70%, #f9d423 100%);
  box-shadow:
    0 0 40rpx rgba(212, 175, 55, 0.7),
    0 0 80rpx rgba(212, 175, 55, 0.3),
    inset 0 4rpx 12rpx rgba(255, 255, 255, 0.4);
  border: 5rpx solid #b8942e;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  animation: medalSpin 0.7s ease 0.1s both;
}

@keyframes medalSpin {
  0% { transform: rotateY(0deg); }
  60% { transform: rotateY(360deg); }
  100% { transform: rotateY(360deg); }
}

.medal-emoji { font-size: 52rpx; line-height: 1; }

.challenge-medal-inner {
  background: linear-gradient(135deg, #f1c40f 0%, #e67e22 30%, #d35400 50%, #e67e22 70%, #f1c40f 100%);
  box-shadow:
    0 0 40rpx rgba(241, 196, 15, 0.7),
    0 0 80rpx rgba(230, 126, 34, 0.3),
    inset 0 4rpx 12rpx rgba(255, 255, 255, 0.4);
  border: 5rpx solid #c0392b;
}

.medal-ribbon {
  position: absolute;
  bottom: -16rpx;
  width: 26rpx;
  height: 50rpx;
  z-index: 0;
}

.medal-ribbon-l {
  left: 50%;
  transform: translateX(-30rpx) rotate(-15deg);
  background: linear-gradient(to bottom, #e74c3c 0%, #c0392b 50%, #a93226 100%);
  border-radius: 4rpx 4rpx 10rpx 10rpx;
}

.medal-ribbon-r {
  left: 50%;
  transform: translateX(4rpx) rotate(15deg);
  background: linear-gradient(to bottom, #e74c3c 0%, #c0392b 50%, #a93226 100%);
  border-radius: 4rpx 4rpx 10rpx 10rpx;
}

.medal-label {
  margin-top: 26rpx;
  color: #d4af37;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-shadow: 0 0 16rpx rgba(212, 175, 55, 0.4);
  text-align: center;
  white-space: nowrap;
}

.challenge-medal-label { color: #f1c40f; }
