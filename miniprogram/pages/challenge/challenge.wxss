/* pages/challenge/challenge.wxss */
.page {
  min-height: 100vh;
  background: #f6efde;
  padding: 0 32rpx 60rpx;
  position: relative;
}

/* ---- 头部 ---- */
.header-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
  background: #f6efde;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #d4af37;
  font-weight: 300;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  letter-spacing: 4rpx;
}

.title-icon { color: #d4af37; }

/* ---- 富豪信息卡 ---- */
.billionaire-card {
  background: #ffffff;
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.billionaire-label {
  font-size: 22rpx;
  color: #d4af37;
  margin-bottom: 16rpx;
}

.billionaire-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.billionaire-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f6efde;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d4af37;
  font-weight: 700;
  font-size: 32rpx;
  border: 2rpx solid #d4af37;
  flex-shrink: 0;
}

.billionaire-info { flex: 1; }
.billionaire-name { font-size: 28rpx; color: #1a1a2e; font-weight: 600; }
.billionaire-assets { font-size: 24rpx; color: #d4af37; margin-top: 4rpx; }

/* ---- 规则卡片 ---- */
.rules-card {
  background: #ffffff;
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 32rpx 32rpx 24rpx;
  margin-bottom: 30rpx;
}

.rules-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #d4af37;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #1a1a2e;
  line-height: 1.6;
}

.rule-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #d4af37;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 操作卡片（创建/加入）---- */
.action-card {
  background: #ffffff;
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.action-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-icon {
  font-size: 52rpx;
  flex-shrink: 0;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.action-desc {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-top: 4rpx;
}

/* 创建房间按钮（右侧紧凑） */
.btn-gold {
  flex-shrink: 0;
  padding: 0 36rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #d4af37;
  color: #1a1a2e;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 房间号输入框（中间） */
.room-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: #f6efde;
  border: 2rpx solid #d4af37;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1a1a2e;
  box-sizing: border-box;
  text-align: center;
}

.room-input::placeholder {
  color: #c0b080;
  font-size: 24rpx;
}

/* 加入按钮（右侧紧凑） */
.btn-join {
  flex-shrink: 0;
  width: 120rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #d4af37;
  color: #1a1a2e;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-join.disabled {
  opacity: 0.4;
}

/* ---- 装饰 ---- */
.wave {
  width: 200rpx;
  height: 16rpx;
  margin: 30rpx auto;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
  border-radius: 50%;
  opacity: 0.3;
}
