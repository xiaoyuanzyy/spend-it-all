/* pages/index/index.wxss */
/* ===== 自定义导航栏 ===== */
.nav-bar {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a1129;
}

.nav-title-frame {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 36rpx;
  border: 2rpx solid #d4af37;
  border-radius: 8rpx;
  position: relative;
  background: rgba(212, 175, 55, 0.08);
  box-shadow: 0 0 16rpx rgba(212, 175, 55, 0.15), inset 0 0 16rpx rgba(212, 175, 55, 0.06);
}

.nav-title-frame::before,
.nav-title-frame::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-color: #d4af37;
  border-style: solid;
}

.nav-title-frame::before {
  top: -4rpx;
  left: -4rpx;
  border-width: 2rpx 0 0 2rpx;
}

.nav-title-frame::after {
  top: -4rpx;
  right: -4rpx;
  border-width: 2rpx 2rpx 0 0;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #d4af37;
  letter-spacing: 4rpx;
}

.page {
  min-height: 100vh;
  background: var(--bg-deep);
  position: relative;
  padding-bottom: 60rpx;
}

.page::before {
  content: '';
  position: absolute;
  top: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 660rpx;
  height: 660rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.12) 0%, transparent 60%);
  pointer-events: none;
}

.status-bar {
  width: 100%;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #f5f1e6;
}

.header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  gap: 20rpx;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #f5f1e6;
}

.header-title .icon {
  width: 36rpx;
  height: 36rpx;
}

.header-actions {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  gap: 12rpx;
}

.header-me {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(212, 175, 55, 0.15);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  font-size: 22rpx;
  color: #d4af37;
}

.header-me-icon {
  width: 28rpx;
  height: 28rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  justify-content: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(212, 175, 55, 0.1);
  color: #d4af37;
  font-size: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}

.wheel-wrap {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin: 20rpx auto 20rpx;
}

.wheel {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  border: 8rpx solid #d4af37;
  box-shadow: 0 0 60rpx rgba(212, 175, 55, 0.4), inset 0 0 30rpx rgba(0, 0, 0, 0.4);
  transition: transform 4s cubic-bezier(0.17, 0.67, 0.32, 1.0);
}

.wheel-inner {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #0a1129;
  border: 4rpx solid #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.3);
}

.inner-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #d4af37;
}

.wheel-pointer {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 36rpx solid #d4af37;
  z-index: 5;
  filter: drop-shadow(0 0 8rpx rgba(212, 175, 55, 0.6));
}

.segment-text {
  position: absolute;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  text-shadow: 0 0 8rpx rgba(0, 0, 0, 0.9);
  white-space: nowrap;
}

.segment-nation {
  position: absolute;
  color: rgba(255, 255, 255, 0.75);
  font-size: 18rpx;
  font-weight: 600;
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.8);
  white-space: nowrap;
}

.spin-btn-wrap {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 40rpx 0 30rpx;
}

.spin-btn {
  width: 320rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: var(--bg-deep);
  border: 4rpx solid #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #d4af37;
  letter-spacing: 4rpx;
  box-shadow: 0 0 30rpx rgba(212, 175, 55, 0.3);
}

.spin-btn.disabled {
  opacity: 0.6;
}

.spin-btn-leaderboard {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #d4af37;
  text-decoration: underline;
  text-underline-offset: 6rpx;
  padding: 8rpx 0;
}

.coins {
  display: flex;
  justify-content: space-between;
  padding: 0 60rpx;
  margin-top: 20rpx;
}

.coin {
  width: 80rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #d4af37, #f5e3a1);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #1a1a2e;
  font-weight: 700;
  transform: rotate(-10deg);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.coin-2 { transform: rotate(5deg) translateY(-10rpx); }
.coin-3 { transform: rotate(-15deg) translateY(5rpx); }

.hint {
  text-align: center;
  color: #a0a0a0;
  font-size: 22rpx;
  margin-top: 24rpx;
}

.feedback-entry {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
}

.feedback-entry text {
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
  background: rgba(212, 175, 55, 0.12);
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  color: #d4af37;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

/* ===== 欢迎弹窗 ===== */
.welcome-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 300;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s;
}

.welcome-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.welcome-card {
  width: 580rpx;
  background: linear-gradient(160deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
  border-radius: 24rpx;
  border: 2rpx solid #d4af37;
  position: relative;
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 0 60rpx rgba(212, 175, 55, 0.3), 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
}

.welcome-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 30%, rgba(212, 175, 55, 0.08) 0%, transparent 50%),
              radial-gradient(circle at 70% 70%, rgba(212, 175, 55, 0.06) 0%, transparent 50%);
  pointer-events: none;
}

/* 关闭按钮 */
.welcome-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all 0.2s;
}

.welcome-close:active {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

/* 四角装饰 */
.welcome-sparkle {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: #d4af37;
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(212, 175, 55, 0.8);
}

.welcome-sparkle.top-left    { top: 24rpx; left: 24rpx; }
.welcome-sparkle.top-right   { top: 24rpx; right: 24rpx; }
.welcome-sparkle.bottom-left { bottom: 24rpx; left: 24rpx; }
.welcome-sparkle.bottom-right{ bottom: 24rpx; right: 24rpx; }

.welcome-crown {
  font-size: 60rpx;
  margin-bottom: 16rpx;
  animation: crownBounce 2s ease-in-out infinite;
}

@keyframes crownBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.welcome-greeting {
  font-size: 34rpx;
  color: #f5f1e6;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.6;
}

.welcome-name {
  color: #d4af37;
  font-weight: 700;
  font-size: 38rpx;
  text-shadow: 0 0 16rpx rgba(212, 175, 55, 0.5);
}

.welcome-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 30rpx 0;
  width: 80%;
}

.welcome-divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
}

.welcome-divider-dot {
  color: #d4af37;
  font-size: 16rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  color: #c4b998;
  letter-spacing: 3rpx;
  text-align: center;
  margin-bottom: 10rpx;
}

.welcome-subtitle-sm {
  font-size: 24rpx;
  color: #d4af37;
  letter-spacing: 4rpx;
  margin-bottom: 40rpx;
}

.welcome-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 100rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d4af37 0%, #f5e3a1 50%, #d4af37 100%);
  color: #1a1a2e;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 30rpx rgba(212, 175, 55, 0.45);
  animation: btnPulse 2s ease-in-out infinite;
}

@keyframes btnPulse {
  0%, 100% { box-shadow: 0 8rpx 30rpx rgba(212, 175, 55, 0.45); }
  50% { box-shadow: 0 8rpx 50rpx rgba(212, 175, 55, 0.7); }
}

.welcome-btn-icon {
  font-size: 36rpx;
}

/* ===== 富豪简介卡片 ===== */
.profile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.profile-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.profile-card {
  width: 620rpx;
  max-height: 88vh;
  background: linear-gradient(180deg, #ffffff 0%, #faf7f0 100%);
  border-radius: 28rpx;
  border: 2rpx solid #d4af37;
  position: relative;
  overflow-y: auto;
  padding: 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
}

.profile-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* ---- 头部：头像 + 姓名 ---- */
.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 50rpx 36rpx 30rpx;
  background: linear-gradient(135deg, #0f3460 0%, #16213e 40%, #1a1a2e 100%);
  border-radius: 28rpx 28rpx 0 0;
  position: relative;
  overflow: hidden;
}

.profile-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, transparent, #d4af37, transparent);
}

.profile-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid #d4af37;
  flex-shrink: 0;
  overflow: hidden;
  box-shadow: 0 0 24rpx rgba(212, 175, 55, 0.35);
}

.profile-avatar {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #d4af37 0%, #f5e3a1 50%, #d4af37 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #1a1a2e;
  font-weight: 700;
}

.profile-header-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #f5f1e6;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.profile-nationality {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 20rpx;
  background: rgba(212, 175, 55, 0.2);
  border: 1rpx solid rgba(212, 175, 55, 0.4);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #d4af37;
  letter-spacing: 2rpx;
}

/* ---- 资产卡片 ---- */
.profile-assets-card {
  margin: -20rpx 32rpx 0;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #d4af37 0%, #f5e3a1 40%, #d4af37 100%);
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(212, 175, 55, 0.35);
  position: relative;
  z-index: 1;
}

.profile-assets-label {
  font-size: 20rpx;
  color: #6b5a1e;
  letter-spacing: 4rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.profile-assets-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: 1rpx;
}

/* ---- 通用区块 ---- */
.profile-block {
  padding: 24rpx 32rpx 0;
}

.profile-block-title {
  font-size: 22rpx;
  color: #8a7a5a;
  font-weight: 600;
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
  padding-left: 4rpx;
}

/* ---- 标签芯片 ---- */
.profile-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f6efde;
  color: #5a4a2e;
  font-size: 22rpx;
  border: 1rpx solid #e0d0b0;
  white-space: nowrap;
}

.profile-chip-sm {
  padding: 6rpx 16rpx;
  font-size: 20rpx;
}

/* ===== 品位偏好核心区块 ===== */
.profile-match-section {
  margin: 20rpx 28rpx 0;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.08) 0%, rgba(245, 227, 161, 0.06) 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.25);
  position: relative;
  overflow: hidden;
}

.profile-match-section::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.profile-match-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.profile-match-icon {
  font-size: 32rpx;
}

.profile-match-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: 2rpx;
}

.profile-match-badge {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d4af37, #f5e3a1);
  color: #1a1a2e;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.profile-match-rule {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 12rpx 0;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ff7860;
  letter-spacing: 2rpx;
}

.profile-match-rule-icon {
  font-size: 30rpx;
}

.profile-match-highlight {
  color: #ff4d3a;
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 6rpx;
  text-decoration-thickness: 3rpx;
}

.profile-match-desc {
  font-size: 22rpx;
  color: #8a7a5a;
  line-height: 1.5;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
  text-align: center;
}

.profile-match-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.profile-match-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #d4af37 0%, #f5e3a1 50%, #d4af37 100%);
  color: #1a1a2e;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 175, 55, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.profile-match-tag-icon {
  font-size: 16rpx;
  color: rgba(26, 26, 46, 0.6);
}

/* ---- 操作引导提示 ---- */
.profile-action-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 20rpx 32rpx 0;
  padding: 14rpx 20rpx;
  background: rgba(212, 175, 55, 0.08);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #8a7a5a;
  letter-spacing: 1rpx;
}

.profile-action-hint-icon {
  font-size: 24rpx;
}

/* ---- 口头禅 ---- */
.profile-catchphrase {
  margin: 24rpx 32rpx;
  padding: 18rpx 24rpx;
  background: #f6efde;
  border-radius: 16rpx;
  border-left: 6rpx solid #d4af37;
  font-size: 26rpx;
  color: #6b5a1e;
  font-style: italic;
  text-align: center;
  letter-spacing: 1rpx;
}

/* ---- 操作按钮 ---- */
.profile-actions {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
  margin-top: 4rpx;
}

.profile-btn-secondary {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 2rpx solid #d4af37;
  color: #8a6e1e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.profile-btn-primary {
  margin: 16rpx 32rpx 32rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d4af37 0%, #f5e3a1 50%, #d4af37 100%);
  color: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 175, 55, 0.4);
}