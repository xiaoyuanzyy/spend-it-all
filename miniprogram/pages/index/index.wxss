/* pages/index/index.wxss */
/* ===== 自定义导航栏 ===== */
.nav-bar {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a1129;
}

.nav-title-frame {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 36rpx;
  border: 2rpx solid #d4af37;
  border-radius: 8rpx;
  position: relative;
  background: rgba(212, 175, 55, 0.08);
  box-shadow: 0 0 16rpx rgba(212, 175, 55, 0.15), inset 0 0 16rpx rgba(212, 175, 55, 0.06);
}

.nav-title-frame::before,
.nav-title-frame::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-color: #d4af37;
  border-style: solid;
}

.nav-title-frame::before {
  top: -4rpx;
  left: -4rpx;
  border-width: 2rpx 0 0 2rpx;
}

.nav-title-frame::after {
  top: -4rpx;
  right: -4rpx;
  border-width: 2rpx 2rpx 0 0;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #d4af37;
  letter-spacing: 4rpx;
}

.page {
  min-height: 100vh;
  background: var(--bg-deep);
  position: relative;
  padding-bottom: 60rpx;
}

.page::before {
  content: '';
  position: absolute;
  top: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 660rpx;
  height: 660rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.12) 0%, transparent 60%);
  pointer-events: none;
}

.status-bar {
  width: 100%;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #f5f1e6;
}

.header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  gap: 20rpx;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #f5f1e6;
}

.header-title .icon {
  width: 36rpx;
  height: 36rpx;
}

.header-actions {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  gap: 12rpx;
}

.header-me {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(212, 175, 55, 0.15);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  font-size: 22rpx;
  color: #d4af37;
}

.header-me-icon {
  width: 28rpx;
  height: 28rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  justify-content: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(212, 175, 55, 0.1);
  color: #d4af37;
  font-size: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.3);
}

.wheel-wrap {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin: 20rpx auto 20rpx;
}

.wheel {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  border: 8rpx solid #d4af37;
  box-shadow: 0 0 60rpx rgba(212, 175, 55, 0.4), inset 0 0 30rpx rgba(0, 0, 0, 0.4);
  transition: transform 4s cubic-bezier(0.17, 0.67, 0.32, 1.0);
}

.wheel-inner {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #0a1129;
  border: 4rpx solid #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.3);
}

.inner-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #d4af37;
}

.wheel-pointer {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 36rpx solid #d4af37;
  z-index: 5;
  filter: drop-shadow(0 0 8rpx rgba(212, 175, 55, 0.6));
}

.segment-text {
  position: absolute;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  text-shadow: 0 0 8rpx rgba(0, 0, 0, 0.9);
  white-space: nowrap;
}

.segment-nation {
  position: absolute;
  color: rgba(255, 255, 255, 0.75);
  font-size: 18rpx;
  font-weight: 600;
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.8);
  white-space: nowrap;
}

.spin-btn-wrap {
  display: flex;
  justify-content: center;
  margin: 40rpx 0 30rpx;
}

.spin-btn {
  width: 320rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: var(--bg-deep);
  border: 4rpx solid #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #d4af37;
  letter-spacing: 4rpx;
  box-shadow: 0 0 30rpx rgba(212, 175, 55, 0.3);
}

.spin-btn.disabled {
  opacity: 0.6;
}

.coins {
  display: flex;
  justify-content: space-between;
  padding: 0 60rpx;
  margin-top: 20rpx;
}

.coin {
  width: 80rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #d4af37, #f5e3a1);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #1a1a2e;
  font-weight: 700;
  transform: rotate(-10deg);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.coin-2 { transform: rotate(5deg) translateY(-10rpx); }
.coin-3 { transform: rotate(-15deg) translateY(5rpx); }

.hint {
  text-align: center;
  color: #a0a0a0;
  font-size: 22rpx;
  margin-top: 24rpx;
}

/* ===== 富豪简介卡片 ===== */
.profile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.profile-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.profile-card {
  width: 600rpx;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 32rpx;
  border: 2rpx solid #d4af37;
  position: relative;
  overflow-y: auto;
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #f5f1e6;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.profile-avatar-wrap {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 4rpx solid #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1a2e;
  overflow: hidden;
}

.profile-avatar {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #d4af37 0%, #f5e3a1 50%, #d4af37 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #1a1a2e;
  font-weight: 700;
}

.profile-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-top: 24rpx;
  letter-spacing: 4rpx;
}

.profile-nationality {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 28rpx;
  background: linear-gradient(135deg, #d4af37, #f5e3a1);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1a1a2e;
  letter-spacing: 2rpx;
}

.profile-section {
  width: 100%;
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-section-label {
  font-size: 24rpx;
  color: #d4af37;
  font-weight: 600;
  letter-spacing: 4rpx;
  position: relative;
  padding: 0 20rpx;
}

.profile-section-label::before,
.profile-section-label::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 60rpx;
  height: 1rpx;
  background: rgba(212, 175, 55, 0.4);
}

.profile-section-label::before { right: 100%; }
.profile-section-label::after { left: 100%; }

.profile-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-top: 20rpx;
}

.profile-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f6efde;
  color: #1a1a2e;
  font-size: 24rpx;
  border: 1rpx solid #d4af37;
}

.profile-assets {
  font-size: 60rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
}

.profile-catchphrase {
  font-size: 30rpx;
  color: #1a1a2e;
  margin: 30rpx 0 20rpx;
}

.profile-actions {
  width: 100%;
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.profile-btn-secondary {
  flex: 1;
  height: 90rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 2rpx solid #d4af37;
  color: #d4af37;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.profile-btn-primary {
  width: 100%;
  height: 100rpx;
  border-radius: 999rpx;
  background: #d4af37;
  color: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 175, 55, 0.4);
}