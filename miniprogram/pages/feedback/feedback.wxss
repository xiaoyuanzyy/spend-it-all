/* pages/feedback/feedback.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f6efde;
  color: #1a1a2e;
  overflow: hidden;
}

.header {
  flex-shrink: 0;
  background: #f6efde;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  position: relative;
}

.nav-back {
  position: absolute;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #d4af37;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #d4af37;
  letter-spacing: 6rpx;
}

/* 表单卡片 */
.form-card {
  flex-shrink: 0;
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid rgba(212, 175, 55, 0.3);
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 28rpx;
}

.form-row {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f8f5ed;
  border: 1rpx solid rgba(212, 175, 55, 0.25);
  border-radius: 10rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  background: #f8f5ed;
  border: 1rpx solid rgba(212, 175, 55, 0.25);
  border-radius: 10rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.char-count {
  font-size: 22rpx;
  color: #999;
}

.submit-btn {
  padding: 14rpx 40rpx;
  background: linear-gradient(135deg, #d4af37, #c9a84c);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}

.submit-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.submit-btn:active {
  opacity: 0.8;
}

/* 留言列表 */
.messages-section {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx 32rpx;
  -webkit-overflow-scrolling: touch;
}

.messages-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.message-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.15);
}

.msg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.msg-nickname {
  font-size: 26rpx;
  font-weight: 700;
  color: #d4af37;
}

.msg-time {
  font-size: 20rpx;
  color: #aaa;
}

.msg-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 24rpx;
  color: #999;
}
