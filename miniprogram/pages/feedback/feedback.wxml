<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">←</view>
      <text class="nav-title">我要留言</text>
    </view>
  </view>

  <!-- 留言表单 -->
  <view class="form-card">
    <view class="form-title">💬 写下你想说的话</view>
    <view class="form-row">
      <text class="form-label">昵称</text>
      <input class="form-input" placeholder="你的昵称（选填）" value="{{nickname}}" bindinput="onNicknameInput" maxlength="20" />
    </view>
    <view class="form-row">
      <text class="form-label">留言</text>
      <textarea class="form-textarea" placeholder="在这里写下你的留言…" value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height />
    </view>
    <view class="form-footer">
      <text class="char-count">{{content.length}}/500</text>
      <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
        {{submitting ? '提交中…' : '提交留言'}}
      </view>
    </view>
  </view>

  <!-- 留言列表 -->
  <view class="messages-section">
    <view class="messages-title">📝 大家的留言</view>
    <block wx:if="{{messages.length > 0}}">
      <view class="message-card" wx:for="{{messages}}" wx:key="_id">
        <view class="msg-head">
          <text class="msg-nickname">{{item.nickname || '匿名用户'}}</text>
          <text class="msg-time">{{item.timeDisplay}}</text>
        </view>
        <view class="msg-content">{{item.content}}</view>
      </view>
    </block>
    <view class="empty" wx:else>
      <view class="empty-text">暂无留言，快来抢沙发吧！</view>
    </view>
  </view>

</view>
